    {
      "from": "social-inbound",
      "to": "loader",
      "label": "Conversa no Inbox e despacho existente"
    },
    {
      "from": "notice",
      "to": "social-connections",
      "label": "Falha de conexão pede correção"
    },
    {
      "from": "personal-channel-editor",
      "to": "personal-channel-api",
